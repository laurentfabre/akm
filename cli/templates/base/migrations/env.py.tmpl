"""Alembic environment — runs migrations over the Neon DIRECT endpoint.

Pooled (transaction-mode) connections break session-scoped DDL/locking, so
migrations must use DATABASE_URL_DIRECT (see goal.md §3).
"""

from __future__ import annotations

import os

from alembic import context
from sqlalchemy import create_engine, pool
from sqlmodel import SQLModel

# Import models so SQLModel.metadata is populated.
from {{app_pkg}}.backend import router  # noqa: F401

target_metadata = SQLModel.metadata


def _url() -> str:
    # Migrations require the DIRECT endpoint — never the pooler (transaction-mode
    # PgBouncer breaks session-scoped DDL/locks).
    url = os.environ.get("DATABASE_URL_DIRECT")
    if not url:
        raise RuntimeError(
            "DATABASE_URL_DIRECT must be set for migrations (use the Neon DIRECT endpoint, not the pooler)"
        )
    return url


def run_migrations_online() -> None:
    engine = create_engine(_url(), poolclass=pool.NullPool)  # sslmode comes from the URL
    with engine.connect() as connection:
        context.configure(connection=connection, target_metadata=target_metadata)
        with context.begin_transaction():
            context.run_migrations()


run_migrations_online()
