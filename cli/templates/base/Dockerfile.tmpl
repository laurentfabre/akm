# {{app_name}} backend container (see goal.md §5).
# Must build for linux/amd64 (Cloudflare Containers requirement).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_SYSTEM_PYTHON=1

WORKDIR /app

# Install uv for fast, reproducible installs.
RUN pip install --no-cache-dir uv

COPY pyproject.toml ./
COPY src ./src
RUN uv pip install --system .

# Drop privileges: a backend or dependency RCE must not run as root in the
# container. (Install steps above need root; runtime does not.)
RUN useradd --create-home --uid 10001 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Stock ASGI server — no custom supervisor needed (see goal.md §0).
CMD ["uvicorn", "{{app_pkg}}.backend.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
