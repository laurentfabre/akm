// static assets (see wrangler.jsonc). In dev, `akm dev` proxies /api/* to the
// backend and everything else to this server.
export default defineConfig({
  plugins: [react()],
  root: "ui",
  build: {
    outDir: "../dist",
    emptyOutDir: true,
  },
  server: {
    host: "127.0.0.1",
    port: 5173,
    strictPort: true,
    // `akm dev` fronts this server on one origin (http://localhost:8787) and
    // tunnels the HMR WebSocket through that origin. Accept the proxied Host so
    // Vite doesn't reject requests that arrive via the proxy.
    allowedHosts: true,
  },
});
