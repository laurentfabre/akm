import { defineConfig } from "vite";
import react from "@vitejs/plugin-react";

// {{app_name}} UI build. Output goes to ./dist, which the Worker serves as
// static assets (see wrangler.jsonc). In dev, `akm dev` proxies /api/* to the
// backend and everything else to this server.
export default defineConfig({
  plugins: [react()],
  root: "ui",
  build: {
    outDir: "../dist",
    emptyOutDir: true,
  },
  server: {
    host: "127.0.0.1",
    port: 5173,
    strictPort: true,
    // `akm dev` fronts this server on one localhost origin (e.g.
    // http://localhost:8787) and tunnels HMR through it; the proxy itself binds
    // 127.0.0.1. Allow only localhost rather than `true` — an explicit allowlist
    // keeps Vite's host check on (defends against DNS-rebinding to the dev
    // server) while still accepting the proxied localhost Host.
    allowedHosts: ["localhost", "127.0.0.1"],
  },
});
